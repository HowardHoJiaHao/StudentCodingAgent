{
  "name": "howard-agent",
  "displayName": "Howard Agent",
  "description": "AI coding assistant for students",
  "version": "0.1.0",
  "publisher": "howard",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Machine Learning"],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "howardAgent",
          "title": "Howard Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "howardAgent": [
        {
          "type": "webview",
          "id": "howardAgent.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "howardAgent.setKey",
        "title": "Sign In (Set Key)",
        "category": "Howard Agent"
      },
      {
        "command": "howardAgent.signOut",
        "title": "Sign Out",
        "category": "Howard Agent"
      },
      {
        "command": "howardAgent.newChat",
        "title": "New Chat",
        "category": "Howard Agent",
        "icon": "$(add)"
      },
      {
        "command": "howardAgent.openInEditor",
        "title": "Open Chat in Editor",
        "category": "Howard Agent",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "howardAgent.newChat",
          "when": "view == howardAgent.chat",
          "group": "navigation"
        },
        {
          "command": "howardAgent.openInEditor",
          "when": "view == howardAgent.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Howard Agent",
      "properties": {
        "howardAgent.endpoint": {
          "type": "string",
          "default": "https://codingagentversion2-production.up.railway.app/v1",
          "markdownDescription": "Your proxy endpoint. Must end in `/v1`."
        },
        "howardAgent.model": {
          "type": "string",
          "default": "deepseek-chat",
          "enum": ["deepseek-chat", "deepseek-reasoner"],
          "markdownEnumDescriptions": [
            "DeepSeek V3 — the one to use for agent work.",
            "DeepSeek R1 — reasons more, but tool calling is less reliable."
          ]
        },
        "howardAgent.autoApprove": {
          "type": "string",
          "default": "never",
          "enum": [
            "never",
            "edits",
            "always"
          ],
          "markdownEnumDescriptions": [
            "Ask before every file edit and shell command.",
            "Auto-approve file edits — they cannot escape the open folder — but always ask before running a shell command.",
            "Never ask. Shell commands run unprompted with your full privileges; only use in a repo you can `git checkout`."
          ],
          "markdownDescription": "When to skip the approval prompt.\n\n- `never` — ask every time.\n- `edits` — auto-approve `write_file`/`edit_file`, which are confined to the open folder; still ask for `run_command`.\n- `always` — approve everything, **including unsandboxed shell commands**."
        }
      }
    }
  }
}
