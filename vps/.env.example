# Copy to .env on the VPS:  cp .env.example .env
#
# This file is the ONLY place your real DeepSeek key exists. It never goes on a
# student machine, never in the extension, never in git. Check that .env is in
# .gitignore before you commit anything.

# ---- your upstream key -------------------------------------------------------
# From https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-real-deepseek-key

# ---- secrets: generate these, don't invent them ------------------------------
#   openssl rand -hex 32
LITELLM_MASTER_KEY=sk-generate-me
LITELLM_SALT_KEY=generate-me
POSTGRES_PASSWORD=generate-me

# ---- your domain -------------------------------------------------------------
# An A record for this must already point at the VPS before you start Caddy.
DOMAIN=api.yourdomain.com
ACME_EMAIL=you@yourdomain.com
