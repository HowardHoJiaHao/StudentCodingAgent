# Copy to admin.env:  cp admin.env.example admin.env
#
# For students.sh only. Deliberately does NOT contain your DeepSeek key — that
# lives on the server (vps/.env or Railway Variables) and nowhere else.

# Where your proxy is. Railway gives you a URL; the VPS path uses your domain.
PROXY=https://litellm-production.up.railway.app
# DOMAIN=api.yourdomain.com     # alternative to PROXY, for the vps/ path

# Must match the server exactly. Anyone with this can mint unlimited credit.
LITELLM_MASTER_KEY=sk-the-master-key-you-set-on-the-server
